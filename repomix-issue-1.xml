                />
              </div>
            </div>
          </details>
        </div>

        <div className="aa-field wide aa-actions">
          <span
            className={`aa-hint ${serverError ? "err" : ""}`.trim()}
            role={serverError ? "alert" : "status"}
            style={{ marginRight: "auto" }}
          >
            {serverError}
          </span>
          <Btn type="button" variant="dim" onClick={close} disabled={busy}>
