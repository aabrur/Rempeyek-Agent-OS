{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rempeyek.org/schemas/agent.schema.json",
  "title": "Agent Node Record",
  "description": "Schema for Rempeyek Agent OS agent node records",
  "type": "object",
  "properties": {
    "node_id": {
      "type": "string",
      "pattern": "^Node-\\d+$"
    },
    "agent_id": {
      "type": "string"
    },
    "display_name": {
      "type": "string"
    },
    "provider": {
      "type": "string",
      "enum": ["claude", "openai", "gemini", "antigravity", "command-code", "local", "other"]
    },
    "status": {
      "type": "string",
      "enum": ["active", "inactive", "disconnected", "degraded", "quarantined"]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "schema_version": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "last_seen_at": {
      "type": "string",
      "format": "date-time"
    },
    "skills_manifest": {
      "type": "string"
    },
    "memory_scope": {
      "type": "string"
    },
    "trust_level": {
      "type": "string",
      "enum": ["restricted", "standard", "trusted"]
    }
  },
  "required": [
    "node_id",
    "agent_id",
    "display_name",
    "provider",
    "status",
    "created_at",
    "schema_version"
  ]
}
