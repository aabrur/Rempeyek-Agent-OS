/* === Stage B structural theme source of truth ===========================
   Existing palette aliases are retained for compatibility. These tokens add
   semantic purpose, layout structure, and component treatment on top. */
:root {
  /* primitives */
  --theme-sans:"Segoe UI Variable","Segoe UI",system-ui,sans-serif;
  --theme-serif:Georgia,"Times New Roman",serif;
  --theme-grotesk:Bahnschrift,"Arial Narrow","Segoe UI",sans-serif;
  --theme-mono:"Cascadia Mono","Cascadia Code",Consolas,monospace;
  /* semantic */
  --font-ui:var(--theme-sans); --font-heading:var(--theme-grotesk); --font-data:var(--theme-mono);
  --heading-case:uppercase; --heading-tracking:.12em;
  --surface-fill:var(--card); --surface-border:var(--line);
  --surface-blur:0px; --surface-radius:10px; --control-radius:7px;
  --surface-shadow:none; --surface-border-width:1px; --surface-border-style:solid; --ui-tracking:normal;
  --sidebar-width:232px; --sidebar-padding:18px 14px; --page-x:30px; --page-y:26px;
  --card-gap:14px; --card-padding:16px; --focus-size:2px; --focus-offset:3px;
  --graph-canvas:#050310; --graph-panel:#0b0918; --graph-note:#46d9ff;
