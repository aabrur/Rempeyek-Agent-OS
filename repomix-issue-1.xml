const tasks = (md) => [...md.matchAll(/^- \[([ xX])\] (.+?) <!-- id: ([a-z0-9-]+) -->$/gm)].map((m) => ({ id: m[3], title: m[2].trim(), status: m[1].toLowerCase() === 'x' ? 'completed' : 'pending' }));
