          onSelect={onSelect} onKeyDown={onKeyDown} setFocusRef={setFocusRef}
        />
      ))}

      <CosmosCore
        core={map.core} selectionId={selectionId}
        effectsOn={effectsOn} reducedMotion={reducedMotion}
        onSelect={onSelect} onKeyDown={onKeyDown} setFocusRef={setFocusRef}
      />
    </m.svg>
