{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rempeyek.org/schemas/session.schema.json",
  "title": "Session Record",
  "description": "Schema for Rempeyek Agent OS session records",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string"
    },
    "node_id": {
      "type": "string"
    },
    "agent_id": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": ["active", "completed", "failed", "interrupted", "cancelled"]
    },
    "task_summary": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "skills_loaded": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "memory_sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "files_changed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ended_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_summary": {
      "type": "string"
    }
  },
  "required": [
    "session_id",
    "node_id",
    "agent_id",
    "task_id",
    "started_at",
    "status"
  ]
}
