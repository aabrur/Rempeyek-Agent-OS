try {
  const pngs = await Promise.all(sizes.map(async size => {
    const output = path.join(temporary, `icon-${size}.png`);
    await sharp(source)
      .resize(size, size, {
        fit: "contain",
        background: { r: 0, g: 0, b: 0, alpha: 0 },
