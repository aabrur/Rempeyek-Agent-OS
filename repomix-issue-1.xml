    { type: "subagent_start", name: "telemetry-writer", detail: "append", ts: "2026-07-06T19:41:02Z" },
    ...Array.from({ length: 40 }, () => ({ type: "heartbeat", name: "Heartbeat Hermes" })),
  ], { limit: 30 });
